{
    "$schema": "https://opencode.ai/config.json",
    "plugin": [
        "opencode-tps-meter@latest"
    ],
    "small_model": "openrouter/deepseek/deepseek-v4-flash-0731",
    "permission": {
        "read": {
            "/nix/store/*": "allow",
            "/tmp/*": "allow",
            "/etc/*": "allow"
        },
        "edit": {
            "/tmp/*": "allow"
        },
        "websearch": "allow"
    },
    "shell": "/home/jonas/.nix-profile/bin/bash",
    "lsp": {
        "clangd": {
            "command": [
                "clangd",
                "--background-index",
                "--header-insertion=never",
                "--clang-tidy"
            ],
            "extensions": [
                ".c",
                ".cpp",
                ".h",
                ".hpp",
                ".cc",
                ".hh"
            ]
        },
        "rust-analyzer": {
            "command": [
                "rust-analyzer"
            ],
            "extensions": [
                ".rs"
            ]
        },
        "basedpyright": {
            "command": [
                "basedpyright"
            ],
            "extensions": [
                ".py"
            ]
        }
    },
    "provider": {
        "llama-server": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "LLaMA Server",
            "options": {
                "baseURL": "http://100.64.0.3:11404/v1"
            },
            "models": {
                "qwen3.8-27b": {
                    "name": "Qwen 3.8 27B ROCmFP4 STRIX",
                    "limit": {
                        "context": 196608,
                        "output": 16384
                    },
                    "attachment": true,
                    "modalities": {
                        "input": [
                            "text",
                            "image"
                        ],
                        "output": [
                            "text"
                        ]
                    }
                },
                "ornith-1.5": {
                    "name": "Ornith 1.5 35B ROCmFP4 STRIX_LEAN",
                    "limit": {
                        "context": 196608,
                        "output": 16384
                    },
                    "attachment": true,
                    "modalities": {
                        "input": [
                            "text",
                            "image"
                        ],
                        "output": [
                            "text"
                        ]
                    }
                }
            }
        }
    },
    "layout": "stretch",
    "agent": {
        "explore": {
            "mode": "subagent",
            "model": "openrouter/deepseek/deepseek-v4-flash-0731",
            "description": "Exploratory agent for researching and investigating topics. Use for understanding combined with filtering/synthesizing information to prevent exploding your own context. Perform simple file reads yourself. Only use when actually *synthesizing* information. Don't use it to read files to you; do it yourself."
        },
        "code": {
            "mode": "subagent",
            "model": "openrouter/deepseek/deepseek-v4-flash-0731",
            "description": "Agent specialized for code generation. Use for mid-size to larger, but self-contained, code generation/editing tasks to prevent exploding your own context. Perform small edits yourself."
        },
        "senses": {
            "mode": "subagent",
            "model": "openrouter/google/gemini-3.7-flash",
            "description": "Agent to use for understanding multimodal content. Use for analyzing image-, video-, and sound-files when you don't have that capability yourself. Provide it with the relevant file path(s) and a description of what you want to understand. It will return a text description of the content."
        }
    }
}
